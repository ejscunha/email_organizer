<div class="flex items-center mb-8">
  <.link navigate={~p"/"} class="text-blue-600 hover:text-blue-800 flex items-center">
    <.icon name="hero-arrow-left" class="h-5 w-5 mr-1" /> Back to index
  </.link>
</div>
<div class="bg-white shadow-md rounded-lg p-6 mb-8">
  <div class="mx-auto px-4 py-8">
    <div class="max-w-6xl mx-auto">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-800">{@category.name}</h1>
        <.link
          navigate={~p"/categories/#{@category.id}/edit"}
          class="bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md text-sm font-medium"
        >
          Edit Category
        </.link>
      </div>
      <p class="text-gray-600 mb-6">{@category.description}</p>
      <div class="border-t border-gray-200 pt-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Emails in this category</h2>
        <div :if={Enum.empty?(@emails.entries)} class="text-center py-8 text-gray-500">
          No emails found in this category.
        </div>
        <div :if={not Enum.empty?(@emails.entries)}>
          <div class="mb-4 flex justify-between items-center">
            <div class="flex items-center">
              <input
                type="checkbox"
                id="select-all"
                phx-click="select_all"
                phx-value-all={
                  if length(@selected_emails) == length(@emails.entries),
                    do: "false",
                    else: "true"
                }
                class="mr-2 h-4 w-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500"
                checked={
                  length(@selected_emails) == length(@emails.entries) and
                    length(@emails.entries) > 0
                }
              />
              <label for="select-all" class="text-sm text-gray-700">Select All</label>
            </div>
            <div class="flex space-x-2">
              <button
                phx-click="delete_selected"
                disabled={Enum.empty?(@selected_emails)}
                class="bg-red-600 hover:bg-red-700 disabled:bg-gray-400 text-white py-1 px-3 rounded-md text-sm font-medium flex items-center"
              >
                <.icon name="hero-trash" class="h-4 w-4 mr-1" /> Delete
              </button>
              <button
                phx-click="unsubscribe_selected"
                disabled={Enum.empty?(@selected_emails)}
                class="bg-yellow-600 hover:bg-yellow-700 disabled:bg-gray-400 text-white py-1 px-3 rounded-md text-sm font-medium flex items-center"
              >
                <.icon name="hero-no-symbol" class="h-4 w-4 mr-1" /> Unsubscribe
              </button>
            </div>
          </div>
          <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
            <table class="w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="px-6 py-3 w-10"></th>
                  <th
                    scope="col"
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                  >
                    <button phx-click="sort" phx-value-field="summary" class="flex items-center">
                      Summary
                      <.icon
                        :if={@sort_by == :summary and @sort_order == :asc}
                        name="hero-chevron-up"
                        class="h-4 w-4 ml-1"
                      />
                      <.icon
                        :if={@sort_by == :summary and @sort_order == :desc}
                        name="hero-chevron-down"
                        class="h-4 w-4 ml-1"
                      />
                    </button>
                  </th>
                  <th
                    scope="col"
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                  >
                    <button phx-click="sort" phx-value-field="from" class="flex items-center">
                      From
                      <.icon
                        :if={@sort_by == :from and @sort_order == :asc}
                        name="hero-chevron-up"
                        class="h-4 w-4 ml-1"
                      />
                      <.icon
                        :if={@sort_by == :from and @sort_order == :desc}
                        name="hero-chevron-down"
                        class="h-4 w-4 ml-1"
                      />
                    </button>
                  </th>
                  <th
                    scope="col"
                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
                  >
                    <button phx-click="sort" phx-value-field="date" class="flex items-center">
                      Date
                      <.icon
                        :if={@sort_by == :date and @sort_order == :asc}
                        name="hero-chevron-up"
                        class="h-4 w-4 ml-1"
                      />
                      <.icon
                        :if={@sort_by == :date and @sort_order == :desc}
                        name="hero-chevron-down"
                        class="h-4 w-4 ml-1"
                      />
                    </button>
                  </th>
                  <th
                    scope="col"
                    class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"
                  >
                    Actions
                  </th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <tr
                  :for={email <- @emails.entries}
                  class="hover:bg-gray-50 cursor-pointer"
                  phx-click={JS.navigate(~p"/emails/#{email.id}")}
                >
                  <td class="px-6 py-4" phx-click="select_email" phx-value-id={email.id}>
                    <input
                      type="checkbox"
                      id={"email-#{email.id}"}
                      class="h-4 w-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500"
                      checked={email.id in @selected_emails}
                    />
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-900 break-words max-w-[250px]">
                    {email.summary}
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-900 break-words max-w-[200px]">
                    {email.from}
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-500">
                    {Calendar.strftime(email.date, "%a, %b %d %Y, %I:%M %p")}
                  </td>
                  <td class="px-6 py-4 text-right text-sm font-medium">
                    <div class="flex justify-end space-x-2">
                      <button
                        phx-click="delete_selected"
                        phx-value-id={email.id}
                        class="text-red-600 hover:text-red-900"
                      >
                        <.icon name="hero-trash" class="h-5 w-5" />
                      </button>
                      <button
                        phx-click="unsubscribe_selected"
                        phx-value-id={email.id}
                        class="text-yellow-600 hover:text-yellow-900"
                      >
                        <.icon name="hero-no-symbol" class="h-5 w-5" />
                      </button>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div id="pagination" class="mt-6 flex items-center justify-between">
            <div class="text-sm text-gray-700">
              Showing <span class="font-medium">{(@page - 1) * @page_size + 1}</span>
              to <span class="font-medium">{min(@page * @page_size, @emails.total_entries)}</span>
              of <span class="font-medium">{@emails.total_entries}</span>
              emails
            </div>
            <div class="flex space-x-2">
              <.link
                :if={@page > 1}
                patch={
                  ~p"/categories/#{@category.id}?page=#{@page - 1}&page_size=#{@page_size}&sort_by=#{@sort_by}&sort_order=#{@sort_order}"
                }
                class="bg-white border border-gray-300 text-gray-500 hover:bg-gray-50 px-4 py-2 text-sm font-medium rounded-md"
              >
                Previous
              </.link>
              <button
                :if={@page <= 1}
                disabled
                class="bg-gray-100 border border-gray-300 text-gray-400 px-4 py-2 text-sm font-medium rounded-md cursor-not-allowed"
              >
                Previous
              </button>
              <.link
                :if={@page < @emails.total_pages}
                patch={
                  ~p"/categories/#{@category.id}?page=#{@page + 1}&page_size=#{@page_size}&sort_by=#{@sort_by}&sort_order=#{@sort_order}"
                }
                class="bg-white border border-gray-300 text-gray-500 hover:bg-gray-50 px-4 py-2 text-sm font-medium rounded-md"
              >
                Next
              </.link>
              <button
                :if={@page >= @emails.total_pages}
                disabled
                class="bg-gray-100 border border-gray-300 text-gray-400 px-4 py-2 text-sm font-medium rounded-md cursor-not-allowed"
              >
                Next
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
